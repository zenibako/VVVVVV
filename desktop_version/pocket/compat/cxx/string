/* Minimal std::string for the Pocket build.
 *
 * openfpgaOS apps have no C++ standard library (see the SDK's
 * of_cxxabi.cpp), so this covers the C++98 subset VVVVVV uses.  The buffer
 * is always NUL-terminated; iterators are plain pointers.  Allocation
 * failure and out-of-range access abort, as there are no exceptions. */
#ifndef VVV_COMPAT_STRING
#define VVV_COMPAT_STRING

#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <utility>

namespace std {

class string
{
public:
    typedef char value_type;
    typedef size_t size_type;
    typedef char *iterator;
    typedef const char *const_iterator;

    static const size_type npos = (size_type) -1;

    string() : buf(empty_buf()), len(0), cap(0) {}
    string(const char *s) : buf(empty_buf()), len(0), cap(0) { assign(s, strlen(s)); }
    string(const char *s, size_type n) : buf(empty_buf()), len(0), cap(0) { assign(s, n); }
    string(size_type n, char c) : buf(empty_buf()), len(0), cap(0) { assign(n, c); }
    string(const char *first, const char *last) : buf(empty_buf()), len(0), cap(0)
    {
        assign(first, last - first);
    }
    string(const string &other) : buf(empty_buf()), len(0), cap(0)
    {
        assign(other.buf, other.len);
    }
    string(const string &other, size_type pos, size_type n = npos)
        : buf(empty_buf()), len(0), cap(0)
    {
        check_pos(other, pos);
        assign(other.buf + pos, clamp(other.len - pos, n));
    }

    ~string()
    {
        if (cap != 0)
        {
            free(buf);
        }
    }

    string &operator=(const string &other)
    {
        if (this != &other)
        {
            assign(other.buf, other.len);
        }
        return *this;
    }
    string &operator=(const char *s) { return assign(s, strlen(s)); }
    string &operator=(char c) { return assign(&c, 1); }

    string &assign(const char *s, size_type n)
    {
        if (overlaps(s))
        {
            /* Assigning from part of ourselves. */
            const string copy(s, n);
            return assign(copy.buf, copy.len);
        }
        reserve(n);
        memcpy(buf, s, n);
        set_length(n);
        return *this;
    }
    string &assign(const char *s) { return assign(s, strlen(s)); }
    string &assign(const string &s) { return *this = s; }
    string &assign(size_type n, char c)
    {
        reserve(n);
        memset(buf, c, n);
        set_length(n);
        return *this;
    }

    const char *c_str() const { return buf; }
    const char *data() const { return buf; }
    size_type size() const { return len; }
    size_type length() const { return len; }
    size_type capacity() const { return cap; }
    bool empty() const { return len == 0; }

    iterator begin() { return buf; }
    const_iterator begin() const { return buf; }
    iterator end() { return buf + len; }
    const_iterator end() const { return buf + len; }

    /* Only dereference is used (*s.rbegin()), so a pointer to the last
     * character stands in for a reverse iterator. */
    iterator rbegin() { return buf + len - 1; }
    const_iterator rbegin() const { return buf + len - 1; }

    char &operator[](size_type i) { return buf[i]; }
    const char &operator[](size_type i) const { return buf[i]; }
    char &at(size_type i) { if (i >= len) abort(); return buf[i]; }
    const char &at(size_type i) const { if (i >= len) abort(); return buf[i]; }
    char &front() { return buf[0]; }
    const char &front() const { return buf[0]; }
    char &back() { return buf[len - 1]; }
    const char &back() const { return buf[len - 1]; }

    void reserve(size_type n)
    {
        if (n <= cap)
        {
            return;
        }
        char *grown = (char *) malloc(n + 1);
        if (grown == NULL)
        {
            abort();
        }
        memcpy(grown, buf, len + 1);
        if (cap != 0)
        {
            free(buf);
        }
        buf = grown;
        cap = n;
    }

    void resize(size_type n, char c = '\0')
    {
        if (n > len)
        {
            grow_for(n);
            memset(buf + len, c, n - len);
        }
        set_length(n);
    }

    void clear()
    {
        if (cap != 0)
        {
            set_length(0);
        }
    }

    void push_back(char c) { append(&c, 1); }
    void pop_back() { set_length(len - 1); }

    string &append(const char *s, size_type n) { return replace(len, 0, s, n); }
    string &append(const char *s) { return append(s, strlen(s)); }
    string &append(const string &s) { return append(s.buf, s.len); }
    string &append(size_type n, char c) { return replace(len, 0, string(n, c)); }
    string &append(const char *first, const char *last) { return append(first, last - first); }

    string &operator+=(const string &s) { return append(s); }
    string &operator+=(const char *s) { return append(s); }
    string &operator+=(char c) { return append(&c, 1); }

    string &insert(size_type pos, const char *s, size_type n) { return replace(pos, 0, s, n); }
    string &insert(size_type pos, const char *s) { return insert(pos, s, strlen(s)); }
    string &insert(size_type pos, const string &s) { return insert(pos, s.buf, s.len); }
    string &insert(size_type pos, size_type n, char c) { return replace(pos, 0, string(n, c)); }

    string &erase(size_type pos = 0, size_type n = npos)
    {
        check_pos(*this, pos);
        return replace(pos, n, "", 0);
    }
    iterator erase(iterator pos)
    {
        const size_type at_index = pos - buf;
        erase(at_index, 1);
        return buf + at_index;
    }
    iterator erase(iterator first, iterator last)
    {
        const size_type at_index = first - buf;
        erase(at_index, last - first);
        return buf + at_index;
    }

    string &replace(size_type pos, size_type n, const char *s, size_type sn)
    {
        check_pos(*this, pos);
        n = clamp(len - pos, n);
        if (overlaps(s))
        {
            const string copy(s, sn);
            return replace(pos, n, copy.buf, copy.len);
        }
        const size_type new_len = len - n + sn;
        grow_for(new_len);
        memmove(buf + pos + sn, buf + pos + n, len - pos - n);
        memcpy(buf + pos, s, sn);
        set_length(new_len);
        return *this;
    }
    string &replace(size_type pos, size_type n, const char *s) { return replace(pos, n, s, strlen(s)); }
    string &replace(size_type pos, size_type n, const string &s) { return replace(pos, n, s.buf, s.len); }

    string substr(size_type pos = 0, size_type n = npos) const
    {
        return string(*this, pos, n);
    }

    size_type find(const char *s, size_type pos, size_type n) const
    {
        if (n == 0)
        {
            return pos <= len ? pos : npos;
        }
        for (size_type i = pos; i + n <= len; ++i)
        {
            if (memcmp(buf + i, s, n) == 0)
            {
                return i;
            }
        }
        return npos;
    }
    size_type find(const char *s, size_type pos = 0) const { return find(s, pos, strlen(s)); }
    size_type find(const string &s, size_type pos = 0) const { return find(s.buf, pos, s.len); }
    size_type find(char c, size_type pos = 0) const
    {
        for (size_type i = pos; i < len; ++i)
        {
            if (buf[i] == c)
            {
                return i;
            }
        }
        return npos;
    }

    size_type rfind(char c, size_type pos = npos) const
    {
        if (len == 0)
        {
            return npos;
        }
        for (size_type i = clamp(len - 1, pos) + 1; i-- > 0;)
        {
            if (buf[i] == c)
            {
                return i;
            }
        }
        return npos;
    }

    size_type find_first_of(const char *set, size_type pos = 0) const
    {
        for (size_type i = pos; i < len; ++i)
        {
            if (strchr(set, buf[i]) != NULL)
            {
                return i;
            }
        }
        return npos;
    }

    size_type find_last_of(const char *set, size_type pos = npos) const
    {
        if (len == 0)
        {
            return npos;
        }
        for (size_type i = clamp(len - 1, pos) + 1; i-- > 0;)
        {
            if (strchr(set, buf[i]) != NULL)
            {
                return i;
            }
        }
        return npos;
    }

    int compare(const string &s) const { return compare_raw(buf, len, s.buf, s.len); }
    int compare(const char *s) const { return compare_raw(buf, len, s, strlen(s)); }
    int compare(size_type pos, size_type n, const char *s) const
    {
        check_pos(*this, pos);
        return compare_raw(buf + pos, clamp(len - pos, n), s, strlen(s));
    }
    int compare(size_type pos, size_type n, const string &s) const
    {
        check_pos(*this, pos);
        return compare_raw(buf + pos, clamp(len - pos, n), s.buf, s.len);
    }

    size_type copy(char *dest, size_type n, size_type pos = 0) const
    {
        check_pos(*this, pos);
        n = clamp(len - pos, n);
        memcpy(dest, buf + pos, n);
        return n;
    }

    void swap(string &other)
    {
        std::swap(buf, other.buf);
        std::swap(len, other.len);
        std::swap(cap, other.cap);
    }

private:
    char *buf;
    size_type len;
    size_type cap; /* 0 means buf is the shared empty buffer */

    static char *empty_buf()
    {
        static char empty[1] = {'\0'};
        return empty;
    }

    /* Whether s points into our own (heap) buffer, which a resize could
     * free before s is read. */
    bool overlaps(const char *s) const
    {
        return cap != 0 && s >= buf && s <= buf + len;
    }

    static size_type clamp(size_type available, size_type n)
    {
        return n < available ? n : available;
    }

    static void check_pos(const string &s, size_type pos)
    {
        if (pos > s.len)
        {
            abort();
        }
    }

    static int compare_raw(const char *a, size_type an, const char *b, size_type bn)
    {
        const int result = memcmp(a, b, an < bn ? an : bn);
        if (result != 0)
        {
            return result;
        }
        return an < bn ? -1 : (an > bn ? 1 : 0);
    }

    void grow_for(size_type n)
    {
        if (n > cap)
        {
            size_type next = cap < 15 ? 15 : cap * 2;
            reserve(next < n ? n : next);
        }
    }

    void set_length(size_type n)
    {
        if (cap == 0)
        {
            /* Never write into the shared empty buffer. */
            if (n == 0)
            {
                return;
            }
            reserve(n);
        }
        len = n;
        buf[len] = '\0';
    }
};

inline string operator+(const string &a, const string &b) { string r(a); r += b; return r; }
inline string operator+(const string &a, const char *b) { string r(a); r += b; return r; }
inline string operator+(const char *a, const string &b) { string r(a); r += b; return r; }
inline string operator+(const string &a, char b) { string r(a); r += b; return r; }
inline string operator+(char a, const string &b) { string r(1, a); r += b; return r; }

inline bool operator==(const string &a, const string &b) { return a.compare(b) == 0; }
inline bool operator==(const string &a, const char *b) { return a.compare(b) == 0; }
inline bool operator==(const char *a, const string &b) { return b.compare(a) == 0; }
inline bool operator!=(const string &a, const string &b) { return a.compare(b) != 0; }
inline bool operator!=(const string &a, const char *b) { return a.compare(b) != 0; }
inline bool operator!=(const char *a, const string &b) { return b.compare(a) != 0; }
inline bool operator<(const string &a, const string &b) { return a.compare(b) < 0; }
inline bool operator>(const string &a, const string &b) { return a.compare(b) > 0; }
inline bool operator<=(const string &a, const string &b) { return a.compare(b) <= 0; }
inline bool operator>=(const string &a, const string &b) { return a.compare(b) >= 0; }

template<>
inline void swap<string>(string &a, string &b) { a.swap(b); }

}

#endif
